DOCKER_IMAGE=your-dockerhub-username/moru-server:latest
CLOUDWATCH_LOG_REGION=ap-northeast-2
CLOUDWATCH_LOG_GROUP=/moru/prod/app
CLOUDWATCH_LOG_BUFFER_SIZE=4m

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

DB_URL=jdbc:mysql://your-db-host:3306/moru?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=
JPA_DDL_AUTO=validate

JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=1h
JWT_REFRESH_TOKEN_EXPIRATION=14d

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_ROUTINE_API_KEY=
GEMINI_ROUTINE_MODEL=gemini-3.5-flash

DEV_AUTH_SECRET=

AWS_CREDENTIALS_ACCESS_KEY=
AWS_CREDENTIALS_SECRET_KEY=
AWS_S3_ENABLED=false
AWS_S3_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_S3_PRESIGN_MINUTES=60

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_ID=com.teammoru.Moru
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY=
APPLE_TOKEN_ENCRYPTION_KEY=
APPLE_WITHDRAWAL_ALLOW_MISSING_CREDENTIAL=false

REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s
MEMBER_WITHDRAWAL_LOCK_TTL=60s
MEMBER_WITHDRAWAL_LOCK_RENEW_INTERVAL=20s
MEMBER_WITHDRAWAL_LOCK_RENEWAL_POOL_SIZE=4

GOOGLE_TTS_ENABLED=false
GOOGLE_TTS_LANGUAGE_CODE=ko-KR
GOOGLE_TTS_VOICE=ko-KR-Standard-A
GOOGLE_TTS_AUDIO_ENCODING=MP3
